---
import ProductionCategoryPage from "../layouts/ProductionCategoryPage.astro";
import { tabletopCategory, ALL_ENTRIES } from "../index";
import type { KnownLocale } from "../types";
import { getUtilityPath } from "@jjlmoya/utils-shared/routing";

export async function getStaticPaths() {
  const locales = Object.keys(tabletopCategory.i18n) as KnownLocale[];
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale: currentLocale } = Astro.params as { locale: KnownLocale };
const category = await tabletopCategory.i18n[currentLocale]!();
const tools = await Promise.all(ALL_ENTRIES.map(async (entry) => {
  const loader = entry.i18n[currentLocale] ?? entry.i18n.en;
  if (!loader) throw new Error(`Missing ${currentLocale} locale for ${entry.id}`);
  const content = await loader();
  return {
    id: entry.id,
    icon: entry.icons.fg,
    title: content.title,
    description: content.description,
    href: getUtilityPath(currentLocale, category.slug, content.slug),
  };
}));
---

<ProductionCategoryPage locale={currentLocale} {category} {tools} />
