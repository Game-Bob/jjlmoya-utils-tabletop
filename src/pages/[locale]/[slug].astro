---
import ProductionUtilityPage from "../../layouts/ProductionUtilityPage.astro";
import { ALL_TOOLS, tabletopCategory } from "../../index";
import type { KnownLocale, ToolLocaleContent } from "../../types";
import { getCategoryPath, getUtilityPath } from "@jjlmoya/utils-shared/routing";

type Loader<T> = () => Promise<{ default: T }>;

export async function getStaticPaths() {
  const paths = [];
  for (const { entry, Component: componentLoader, SEOComponent: seoLoader, BibliographyComponent: bibliographyLoader } of ALL_TOOLS) {
    const localeContents = await Promise.all(Object.entries(entry.i18n).map(async ([locale, loader]) => ({
      locale: locale as KnownLocale,
      content: await loader!(),
    })));
    const { default: Component } = await (componentLoader as Loader<any>)();
    const { default: SEOComponent } = await (seoLoader as Loader<any>)();
    const { default: BibliographyComponent } = await (bibliographyLoader as Loader<any>)();
    for (const { locale, content } of localeContents) {
      const category = await tabletopCategory.i18n[locale]!();
      paths.push({
        params: { locale, slug: content.slug },
        props: { entry, locale, content, categorySlug: category.slug, Component, SEOComponent, BibliographyComponent },
      });
    }
  }
  return paths;
}

type PageProps = {
  entry: { id: string; i18n: Record<string, () => Promise<ToolLocaleContent>> };
  locale: KnownLocale;
  content: ToolLocaleContent;
  categorySlug: string;
  Component: any;
  SEOComponent: any;
  BibliographyComponent: any;
};

const { entry, locale, content, categorySlug, Component, SEOComponent, BibliographyComponent } = Astro.props as PageProps;
const relatedTools = (await Promise.all(ALL_TOOLS.map(async ({ entry: relatedEntry }) => {
  if (relatedEntry.id === entry.id) return null;
  const loader = relatedEntry.i18n[locale] ?? relatedEntry.i18n.en;
  if (!loader) return null;
  const relatedContent = await loader();
  return { title: relatedContent.title, description: relatedContent.description, href: getUtilityPath(locale, categorySlug, relatedContent.slug) };
}))).filter(Boolean) as { title: string; description: string; href: string }[];
---

<ProductionUtilityPage
  {locale}
  {content}
  categoryTitle="Tabletop"
  {categorySlug}
  categoryHref={getCategoryPath(locale, categorySlug)}
  {relatedTools}
  {Component}
  {SEOComponent}
  {BibliographyComponent}
/>
